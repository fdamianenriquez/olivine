{
  "name": "olivine",
  "version": "0.2.1",
  "description": "React components drawn in ink on paper: Japanese minimalism, web brutalism, an olive-and-maple palette.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui"
  ],
  "license": "MIT",
  "author": "Damian Enriquez",
  "homepage": "https://fdamianenriquez.github.io/olivine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdamianenriquez/olivine.git"
  },
  "bugs": {
    "url": "https://github.com/fdamianenriquez/olivine/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/olivine.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts-jp.css": "./dist/fonts-jp.css",
    "./components.css": "./dist/components.css",
    "./motion-extras.css": "./dist/motion-extras.css",
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm tokens && tsdown && pnpm build:css",
    "build:css": "tsx scripts/build-css.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "fonts:vendor": "tsx scripts/vendor-fonts.ts && pnpm tokens",
    "lint": "eslint . --max-warnings 0 && stylelint \"{src,stories}/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "contrast": "tsx scripts/check-contrast.ts",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css tokens.css fonts.css fonts-jp.css components.css motion-extras.css",
    "size": "size-limit",
    "storybook:build": "storybook build -o storybook-static",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm contrast && pnpm test && pnpm build && pnpm check:package && pnpm size",
    "changeset": "changeset",
    "release": "pnpm check && changeset publish",
    "prepare": "husky",
    "visual": "tsx scripts/visual.ts test",
    "visual:update": "tsx scripts/visual.ts update",
    "a11y": "tsx scripts/visual.ts test --project=a11y",
    "ssr:prepare": "tsx scripts/ssr-prepare.ts",
    "ssr": "playwright test -c playwright.ssr.config.ts",
    "check:playwright": "tsx scripts/check-playwright-image.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "9.39.5",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/xanh-mono": "^5.3.0",
    "@fontsource/yuji-syuku": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.2.0",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsdown": "0.23.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
